#!/usr/bin/env zsh
emulate -L zsh

pattern_dir="${0:A:h}/patterns/active"

# Gather every active pattern file (nullglob: no match => empty, not an error)
files=($pattern_dir/*.txt(N))
if (( ${#files} == 0 )); then
  echo "guard: no active pattern files in $pattern_dir — refusing to commit blind."
  echo "  Add a *.txt there, or bypass once with: git commit --no-verify"
  exit 1
fi

# Load non-comment, non-blank lines from ALL active files; drop empties
patterns=("${(@f)$(cat -- $files | grep -vE '^[[:space:]]*(#|$)')}")
patterns=(${(M)patterns:#?*})
if (( ${#patterns} == 0 )); then
  echo "guard: active pattern files contain no usable patterns — refusing to commit blind."
  exit 1
fi

staged=$(git diff --cached --name-only --diff-filter=ACM)
[[ -z $staged ]] && exit 0

fail=0
for f in ${(f)staged}; do
  content=$(git show ":$f" 2>/dev/null) || continue
  for p in $patterns; do
    if print -r -- "$content" | grep -Eq -- "$p"; then
      echo "Blocked: '$f' matches secret pattern  /$p/"
      fail=1
    fi
  done
done

(( fail )) && {
  echo "\nCommit aborted — secrets belong in your out-of-git env file."
  echo "False positive? Tune the pattern, archive its file, or use --no-verify."
  exit 1
}
exit 0
